ação\" cumpra seu papel social e nacional.\n    \n- **[[ISO-IEC 42001","line":142},{"title":"NIT","target":"NIT","line":146},{"title":"Soberania Tecnológica","target":"Soberania Tecnológica","line":148}],"task_lines":[],"tasks":{},"codeblock_ranges":[]},"smart_blocks:05_Notas_de_Estudo/Ecossistema de Manuais de Ciência, Tecnologia e Invoção (UNICIETEC)/Manual de Redação de Patentes.md#(Manual de Redação de Patentes (INPI))": {"path":null,"last_embed":{"hash":"fqesxs","at":1780338665759},"embeddings":{"TaylorAI/bge-micro-v2":{"vec":[-0.04282097,-0.00780616,0.01263986,-0.05544695,0.02655759,0.01330438,-0.04246893,0.05595308,-0.0012667,0.02338074,-0.05005072,-0.09556291,0.01047721,0.01231178,-0.02563357,-0.00580237,-0.0431352,0.01226285,-0.0043832,-0.00553215,0.18204039,-0.03035858,-0.06286674,0.00405268,0.00185591,0.0101316,-0.00355248,-0.00538894,-0.02888235,-0.18036547,0.02186088,0.01808897,0.0088999,-0.00583978,-0.02370751,-0.02302373,-0.07604761,0.00267993,0.01767183,-0.00900969,-0.0107885,0.0025571,0.00612506,-0.02721383,-0.00652425,-0.03716135,0.0277671,0.00843807,-0.05070804,-0.00300885,-0.03029786,-0.01974072,0.01283487,-0.01354092,-0.04798952,0.00046002,0.10945618,0.01891395,0.08738117,-0.00147144,0.12529194,0.05439788,-0.25538129,0.04763233,0.0368153,-0.04301153,-0.06472023,-0.01667324,0.0332861,-0.03399565,0.01848527,0.00951911,0.08412583,0.04967636,0.07549284,0.03403866,-0.01467329,-0.04471379,-0.03649375,-0.03818676,0.01279157,0.06275611,-0.04197393,0.00378794,-0.02250803,-0.00990438,0.01442055,-0.03359114,0.02671306,0.03562243,-0.04173397,-0.01778617,0.02873131,0.05605622,-0.02781899,-0.05042856,0.00889807,0.0478835,-0.04634724,0.07177982,-0.0266193,-0.0060366,0.02393442,0.01294439,0.0864374,-0.00511048,-0.01687353,-0.06288254,-0.00322573,0.06175918,0.01744187,-0.0119618,0.05728345,-0.00692589,-0.03249584,0.01210691,0.02535492,0.03573173,0.03282706,-0.00422464,-0.06695083,-0.00108971,0.04163817,0.00483826,0.01906197,-0.0616322,0.03915203,0.05192233,-0.01